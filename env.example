# ═══════════════════════════════════════════════════════════════════════════════
# Production Trading Platform - Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════

# ─── MODE ───────────────────────────────────────────────────────────────────────
# 'paper' = Simulated trading with fake money (default)
# 'live'  = Real trading with actual funds (DANGEROUS - use with extreme caution)
MODE=paper

# ─── DATABASE ───────────────────────────────────────────────────────────────────
DB_PASSWORD=trading_secret_2024
DATABASE_URL=postgresql://trading_user:trading_secret_2024@postgres:5432/trading_platform

# ─── REDIS ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── AUTHENTICATION ─────────────────────────────────────────────────────────────
# Generate a secure random key for production!
# python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# ─── GROK AI (xAI) ──────────────────────────────────────────────────────────────
# Get your API key from https://x.ai/api
XAI_API_KEY=your_xai_api_key_here

# ─── OPENAI (Git Commit Flow) ────────────────────────────────────────────────────
# Get your API key from https://platform.openai.com/api-keys
# Used by scripts/commit.sh for AI-powered commit messages
OPENAI_API_KEY=your_openai_api_key_here

# ─── BINANCE ────────────────────────────────────────────────────────────────────
# Only required for live trading
# For paper trading, leave empty (uses public endpoints)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ─── X (TWITTER) API ────────────────────────────────────────────────────────────
# Required for stock hype detection via X
# Get your bearer token from https://developer.twitter.com/
X_BEARER_TOKEN=

# ─── CAPTRADER / IBKR (Stock Trading) ────────────────────────────────────────────
# Only required for live stock trading
# For paper trading, leave empty
CAPTRADER_USERNAME=
CAPTRADER_PASSWORD=
CAPTRADER_ACCOUNT_ID=

# ─── MONITORING ─────────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=admin

# ─── STRATEGY PARAMETERS ──────────────────────────────────────────────────────
SCORE_THRESHOLD=65              # Minimum |Score| to enter trade
VOLUME_FILTER_RATIO=0.80        # 1h volume must be >= 80% of 24h average
RISK_PER_TRADE=0.02             # Risk 2% of equity per trade
STOP_LOSS_ATR_MULT=1.5          # Stop loss at 1.5x ATR
TAKE_PROFIT_ATR_MULT=4.0        # Take profit at 4x ATR
INITIAL_BALANCE=108000          # Starting paper equity (100k EUR ≈ 108k USDT)
FLATTEN_TIME_CET=23:55          # Daily flatten time in CET

# ─── PAPER TRADING ────────────────────────────────────────────────────────────
PAPER_ACCOUNT_ID=paper_main     # Paper account identifier
# Fee structure (Binance Futures VIP 0)
# Maker: 0.02%, Taker: 0.05% - hardcoded in market_simulator.py

# ─── RISK PARAMETERS (Harmonic across Crypto & Stocks) ─────────────────────────
# These limits apply to both asset types for consistency
# POSITION_LIMIT_PER_ASSET=0.15  # Max 15% in single asset
# POSITION_LIMIT_ALTCOINS=0.40   # Max 40% in altcoins/non-big-tech
# MAX_DEPLOYED=0.70              # Max 70% deployed
# MAX_DAILY_LOSS=0.04            # 4% daily loss circuit breaker
# MIN_LEVERAGE=3.0               # Minimum leverage (3x)
# MAX_LEVERAGE=5.0               # Maximum leverage (5x)
# DRAWDOWN_LEVEL_1=0.05          # 5% daily drawdown triggers level 1
# DRAWDOWN_LEVEL_2=0.10          # 10% daily drawdown triggers level 2
# DRAWDOWN_LEVEL_3=0.15          # 15% daily drawdown triggers level 3

# ─── PORTFOLIO ALLOCATION ─────────────────────────────────────────────────────────
CRYPTO_INITIAL_EQUITY=100000    # 100k USDT for crypto
STOCK_INITIAL_EQUITY=100000     # 100k USD for stocks
STOCK_CORE_ALLOCATION=0.80      # 80% for core tech stocks
STOCK_RESERVED_ALLOCATION=0.20  # 20% for X hype plays