# ═══════════════════════════════════════════════════════════════════════════════
# Production Trading Platform - Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════

# ─── MODE ───────────────────────────────────────────────────────────────────────
# 'paper' = Simulated trading with fake money (default)
# 'live'  = Real trading with actual funds (DANGEROUS - use with extreme caution)
MODE=paper

# ─── SIGNAL MODE ─────────────────────────────────────────────────────────────────
# Set to 'true' to reverse all Grok signals (contrarian mode)
# LONG becomes SHORT, SHORT becomes LONG
REVERSE_SIGNALS=false

# ─── DATABASE ───────────────────────────────────────────────────────────────────
DB_PASSWORD=trading_secret_2024
DATABASE_URL=postgresql://trading_user:trading_secret_2024@postgres:5432/trading_platform

# ─── AUTHENTICATION ─────────────────────────────────────────────────────────────
# Generate a secure random key for production!
# python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# ─── GROK AI (xAI) ──────────────────────────────────────────────────────────────
# Get your API key from https://x.ai/api
XAI_API_KEY=your_xai_api_key_here

# ─── OPENAI (Git Commit Flow) ────────────────────────────────────────────────────
# Get your API key from https://platform.openai.com/api-keys
# Used by scripts/commit.sh for AI-powered commit messages
OPENAI_API_KEY=your_openai_api_key_here

# ─── BINANCE ────────────────────────────────────────────────────────────────────
# Only required for live trading
# For paper trading, leave empty (uses public endpoints)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ─── X (TWITTER) API ────────────────────────────────────────────────────────────
# Required for stock hype detection via X
# Get your bearer token from https://developer.twitter.com/
X_BEARER_TOKEN=

# ─── CAPTRADER / IBKR (Stock Trading) ────────────────────────────────────────────
# Only required for live stock trading
# For paper trading, leave empty
CAPTRADER_USERNAME=
CAPTRADER_PASSWORD=
CAPTRADER_ACCOUNT_ID=

# ─── MONITORING ─────────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=admin

# ─── STRATEGY PARAMETERS ──────────────────────────────────────────────────────
# NORMAL MODE (conservative)
# SCORE_THRESHOLD=65              # Minimum |Score| to enter trade
# VOLUME_FILTER_RATIO=0.80        # 1h volume must be >= 80% of 24h average
# MIN_LEVERAGE=3.0                # Minimum leverage floor
# MAX_LEVERAGE=5.0                # Maximum adaptive leverage

# AGGRESSIVE MODE (testing) - CURRENTLY ACTIVE
SCORE_THRESHOLD=50              # Lowered from 65
VOLUME_FILTER_RATIO=0.70        # Lowered from 0.80
RISK_PER_TRADE=0.02             # Risk 2% of equity per new trade
RISK_PER_REBALANCE=0.015        # Risk 1.5% per rebalance
REBALANCE_THRESHOLD=0.15        # 15% score shift triggers rebalance
STOP_LOSS_ATR_MULT=1.5          # Stop loss at 1.5x ATR
TAKE_PROFIT_ATR_MULT=4.0        # Take profit at 4x ATR
INITIAL_BALANCE=100000          # Starting paper equity
FLATTEN_TIME_CET=23:55          # Daily flatten time in CET

# ─── AGGRESSIVE MODE SPECIFIC ─────────────────────────────────────────────────
CYCLE_MINUTES=15                # Run strategy every 15 minutes (was 60)
MIN_COINS_PER_CYCLE=5           # Minimum coins to select per cycle
MAX_COINS_PER_CYCLE=8           # Maximum coins to select per cycle
TARGET_DEPLOYMENT=0.80          # Target 80% portfolio deployment
MIN_LEVERAGE=4.0                # Minimum leverage (raised from 3x)
MAX_LEVERAGE=7.0                # Maximum leverage (raised from 5x)
FORCE_TRADE=false               # Set to 'true' to generate 100+ trades/day for testing

# ─── PAPER TRADING ────────────────────────────────────────────────────────────
PAPER_ACCOUNT_ID=paper_main     # Paper account identifier
# Fee structure (Binance Futures VIP 0)
# Maker: 0.02%, Taker: 0.05% - hardcoded in market_simulator.py

# ─── RISK PARAMETERS (AGGRESSIVE MODE) ─────────────────────────────────────────
# Relaxed limits for high-velocity testing
PER_ASSET_LIMIT=0.20            # Max 20% in single asset (was 15%)
POSITION_LIMIT_ALTCOINS=0.50    # Max 50% in altcoins/non-big-tech (was 40%)
MAX_DEPLOYED=0.90               # Max 90% deployed (was 70%)
DAILY_LOSS_LIMIT=0.06           # 6% daily loss circuit breaker (was 4%)
DRAWDOWN_LEVEL_1=0.05           # 5% daily drawdown triggers level 1
DRAWDOWN_LEVEL_2=0.10           # 10% daily drawdown triggers level 2
DRAWDOWN_LEVEL_3=0.15           # 15% daily drawdown triggers level 3

# ─── PORTFOLIO ALLOCATION ─────────────────────────────────────────────────────────
CRYPTO_INITIAL_EQUITY=100000    # 100k USDT for crypto
STOCK_INITIAL_EQUITY=100000     # 100k USD for stocks
STOCK_CORE_ALLOCATION=0.80      # 80% for core tech stocks
STOCK_RESERVED_ALLOCATION=0.20  # 20% for X hype plays