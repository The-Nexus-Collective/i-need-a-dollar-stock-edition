# I Need A Dollar - Environment Configuration
# Copy this file to .env and fill in your values

# ═══════════════════════════════════════════════════════════════════
# DATABASE
# ═══════════════════════════════════════════════════════════════════
DATABASE_URL=jdbc:postgresql://localhost:5432/trading
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ═══════════════════════════════════════════════════════════════════
# TRADING MODE
# ═══════════════════════════════════════════════════════════════════
# paper = simulated trading (default)
# live = real trading (requires Binance API keys)
MODE=paper

# ═══════════════════════════════════════════════════════════════════
# EXTERNAL APIS
# ═══════════════════════════════════════════════════════════════════
# Grok xAI API key for AI analysis
XAI_API_KEY=

# Binance API (optional - only for live trading)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ═══════════════════════════════════════════════════════════════════
# TRADING CONFIGURATION
# ═══════════════════════════════════════════════════════════════════
# Trading cycle interval in milliseconds (default: 10 minutes)
CYCLE_INTERVAL=600000

# Starting capital in USDT
STARTING_CAPITAL=100000

# Position size as percentage of capital (0.02 = 2%)
POSITION_SIZE_PCT=0.02

# Maximum number of open positions
MAX_POSITIONS=50

# Deployment ratio targets (75-90% of capital deployed)
MIN_DEPLOYMENT_RATIO=0.75
MAX_DEPLOYMENT_RATIO=0.90

# ═══════════════════════════════════════════════════════════════════
# CORS (Cross-Origin Resource Sharing)
# ═══════════════════════════════════════════════════════════════════
# Set to true to allow all origins (development only)
CORS_ALLOW_ALL=true

# Comma-separated list of allowed origins (production)
# CORS_ORIGINS=https://yourdomain.com

# ═══════════════════════════════════════════════════════════════════
# MONITORING (Optional)
# ═══════════════════════════════════════════════════════════════════
GRAFANA_PASSWORD=admin
